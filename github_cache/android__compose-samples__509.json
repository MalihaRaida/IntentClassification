n/java/com/example/jetsnack/ui/home/cart/Cart.kt", "user": "angeles-bilbao6", "created_at": "2021-08-31T17:13:13Z", "body": "Done!"}, {"id": 700370632, "in_reply_to_id": 630024875, "path": "Jetsnack/app/src/main/java/com/example/jetsnack/ui/home/cart/SwipeDismissItem.kt", "user": "JoseAlcerreca", "created_at": "2021-09-01T16:20:13Z", "body": "Comments on classes or functions must be in the kdoc form, otherwise they're not picked up by tools:\r\n\r\n/**\r\n * Holds the Swipe to dismiss composable, its animation and the current state\r\n */"}]}